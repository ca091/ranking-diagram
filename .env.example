# 复制为 .env 后填写。全部为服务端变量（NUXT_ 前缀），不会下发到浏览器。

# —— LLM Provider —— anthropic | qwen（新增厂商见 server/utils/llm/index.ts）
NUXT_LLM_PROVIDER=anthropic
# 端点留空 = provider 默认：anthropic → api.anthropic.com；qwen → DashScope 国内站
# qwen 新加坡站填 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
NUXT_LLM_BASE_URL=
NUXT_LLM_API_KEY=
# 模型留空 = provider 默认：anthropic → claude-sonnet-5 / claude-haiku-4-5-20251001
#                              qwen     → qwen-plus / qwen-turbo
NUXT_MODEL_RANKING=
NUXT_MODEL_GATE=

# —— 搜索（Tavily，免费 1000 credits/月）——
NUXT_TAVILY_API_KEY=

# —— 无密钥开发模式：置 1 后端直接用内置 fixture 走完整 SSE 流程 ——
NUXT_USE_FIXTURE=1
