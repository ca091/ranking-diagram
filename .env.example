# 复制为 .env 后填写。全部为服务端变量（NUXT_ 前缀），不会下发到浏览器。

# —— LLM（Anthropic 兼容端点，base url + key 自配）——
NUXT_ANTHROPIC_BASE_URL=
NUXT_ANTHROPIC_API_KEY=
# 排行 agent 用的主力模型
NUXT_MODEL_RANKING=claude-sonnet-5
# 可排行性校验 gate 用的轻量模型
NUXT_MODEL_GATE=claude-haiku-4-5-20251001

# —— 搜索（Tavily，免费 1000 credits/月）——
NUXT_TAVILY_API_KEY=

# —— 无密钥开发模式：置 1 后端直接用内置 fixture 走完整 SSE 流程 ——
NUXT_USE_FIXTURE=0
