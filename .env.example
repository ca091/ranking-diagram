# ⚠️ 切换/配置模型只需要改这一个文件；
#    nuxt.config.ts 是环境变量声明骨架（保持空值），server/utils/llm/*.ts 是厂商插件（不用动）。

# —— LLM Provider —— anthropic | qwen（缺省 anthropic；新增厂商见 server/utils/llm/index.ts）
NUXT_LLM_PROVIDER=
# 端点留空 = provider 插件的默认端点：anthropic → api.anthropic.com；qwen → DashScope 国内站
# qwen 新加坡站填 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
NUXT_LLM_BASE_URL=
NUXT_LLM_API_KEY=
# 模型留空 = provider 插件默认：anthropic → claude-sonnet-5 / claude-haiku-4-5-20251001
#                              qwen     → qwen-plus / qwen-turbo
NUXT_MODEL_RANKING=
NUXT_MODEL_GATE=
# 单次生成总超时(ms)，留空=120000；推理型模型（思维链很慢）建议 240000~300000
NUXT_LLM_TIMEOUT_MS=
# 思考模式（qwen3.8-flash 等默认开思考、拖慢整链）：留空=关；置 1 恢复思维链。
# 若某些兼容模型不认 enable_thinking 参数报 400，也用它回退（=1 时不再注入该参数）
NUXT_LLM_THINKING=

# —— 搜索（Tavily，免费 1000 credits/月）——
NUXT_TAVILY_API_KEY=

# —— 无密钥开发模式：置 1 后端直接用内置 fixture 走完整 SSE 流程 ——
NUXT_USE_FIXTURE=1

# —— 任务级结构化日志（prompt/各环节耗时/终态，每次生成一行 JSON）：置 0 关闭 ——
# NUXT_LOG_GENERATION=0
